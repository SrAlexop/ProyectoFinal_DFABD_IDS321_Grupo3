                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="AnioMes" msprop:DbColumnName="AnioMes" msprop:design-time-name="22d479cb-0f80-43cd-86fc-0ce785481b5e" type="xs:int" minOccurs="0" />
