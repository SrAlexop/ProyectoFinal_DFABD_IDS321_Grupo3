  <Source dwd:design-time-name="32e131ca-265c-4c65-83ad-faf0ca3db9a5">
    <DataSourceViewID>COVID DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="59cd1756-8ba8-4f93-91f9-4f80e04ba494">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T06:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T06:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].IndiceVulnerabilidad
 AS DIVIDE([Measures].[Indice Vulnerabilidad Suma], [Measures].[Indicadores Count]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Indicadores'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].MortalidadPorCienMil
 AS DIVIDE([Measures].[Muertes], [Measures].[Poblacion]) * 100000, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].IncidenciaPorCienMil
 AS DIVIDE([Measures].[Casos Confirmados], [Measures].[Poblacion]) * 100000, 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].CrecimientoMensualCasos
 AS IIF([Dim Tiempo].[Anio Mes].CurrentMember.Level.Ordinal = 0, NULL, 
IIF(([Measures].[Casos Nuevos], [Dim Tiempo].[Anio Mes].CurrentMember.PrevMember) = 0, NULL, 
([Measures].[Casos Nuevos] - ([Measures].[Casos Nuevos], [Dim Tiempo].[Anio Mes].CurrentMember.PrevMember)) / ([Measures].[Casos Nuevos], [Dim Tiempo].[Anio Mes].CurrentMember.PrevMember))), 
FORMAT_STRING = "#,##0.00 %;-#,##0.00 %", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].TasaRecuperacion
 AS DIVIDE([Measures].[Recuperados], [Measures].[Casos Confirmados]), 
FORMAT_STRING = "#,##0.00 %;-#,##0.00 %", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].TasaCasosActivos
 AS IIF([Measures].[Casos Confirmados] = 0, NULL, [Measures].[Activos] / [Measures].[Casos Confirmados]), 
FORMAT_STRING = "#,##0.00 %;-#,##0.00 %", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].TasaFatalidadCalc
 AS IIF([Measures].[Casos Confirmados] = 0, NULL, [Measures].[Muertes] / [Measures].[Casos Confirmados]), 
FORMAT_STRING = "#,##0.00 %;-#,##0.00 %", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Covid Diario'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="4951b9af-e0e9-41d9-ba14-661b303e81fa">
      <ID>KPI</ID>
      <Name>KPI Fatalidad</Name>
      <Value>[Measures].[TasaFatalidadCalc]</Value>
      <Goal>([Measures].[TasaFatalidadCalc],
 [Dim Pais].[Nombre Pais].DefaultMember,
 [Dim Pais].[Region].DefaultMember)</Goal>
      <Status>CASE
 WHEN IsEmpty(KPIValue("KPI Fatalidad")) THEN NULL
 WHEN KPIValue("KPI Fatalidad") &lt;= KPIGoal("KPI Fatalidad") THEN 1
 WHEN KPIValue("KPI Fatalidad") &lt;= KPIGoal("KPI Fatalidad") * 1.25 THEN 0
 ELSE -1
END</Status>
      <Trend>CASE
 WHEN [Dim Tiempo].[Anio].CurrentMember.Level.Ordinal = 0 THEN 0
 WHEN IsEmpty(([Measures].[TasaFatalidadCalc], [Dim Tiempo].[Anio].CurrentMember.PrevMember)) THEN 0
 WHEN [Measures].[TasaFatalidadCalc] &gt; ([Measures].[TasaFatalidadCalc], [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 1.10 THEN 1
 WHEN [Measures].[TasaFatalidadCalc] &lt; ([Measures].[TasaFatalidadCalc], [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 0.90 THEN -1
 ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="eadfca1d-04f2-4d01-b654-f2b4c6d31216">
      <ID>KPI 1</ID>
      <Name>KPI Incidencia</Name>
      <Value>[Measures].[IncidenciaPorCienMil]</Value>
      <Goal>([Measures].[IncidenciaPorCienMil],
 [Dim Pais].[Nombre Pais].DefaultMember,
 [Dim Pais].[Region].DefaultMember)</Goal>
      <Status>CASE
 WHEN IsEmpty(KPIValue("KPI Incidencia")) THEN NULL
 WHEN KPIValue("KPI Incidencia") &lt;= KPIGoal("KPI Incidencia") THEN 1
 WHEN KPIValue("KPI Incidencia") &lt;= KPIGoal("KPI Incidencia") * 1.25 THEN 0
 ELSE -1
END</Status>
      <Trend>CASE
 WHEN [Dim Tiempo].[Anio].CurrentMember.Level.Ordinal = 0 THEN 0
 WHEN IsEmpty(([Measures].[Casos Nuevos],
               [Dim Tiempo].[Anio].CurrentMember.PrevMember)) THEN 0
 WHEN [Measures].[Casos Nuevos] &gt;
      ([Measures].[Casos Nuevos],
       [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 1.10 THEN 1
 WHEN [Measures].[Casos Nuevos] &lt;
      ([Measures].[Casos Nuevos],
       [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 0.90 THEN -1
 ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="d44c10fc-cf99-4c47-92c8-a2828f2ae169">
      <ID>KPI 2</ID>
      <Name>KPI Mortalidad</Name>
      <Value>[Measures].[MortalidadPorCienMil]</Value>
      <Goal>([Measures].[MortalidadPorCienMil],
 [Dim Pais].[Nombre Pais].DefaultMember,
 [Dim Pais].[Region].DefaultMember)</Goal>
      <Status>CASE
 WHEN IsEmpty(KPIValue("KPI Mortalidad")) THEN NULL
 WHEN KPIValue("KPI Mortalidad") &lt;= KPIGoal("KPI Mortalidad") THEN 1
 WHEN KPIValue("KPI Mortalidad") &lt;= KPIGoal("KPI Mortalidad") * 1.25 THEN 0
 ELSE -1
END</Status>
      <Trend>CASE
 WHEN [Dim Tiempo].[Anio].CurrentMember.Level.Ordinal = 0 THEN 0
 WHEN IsEmpty(([Measures].[Muertes Nuevas],
               [Dim Tiempo].[Anio].CurrentMember.PrevMember)) THEN 0
 WHEN [Measures].[Muertes Nuevas] &gt;
      ([Measures].[Muertes Nuevas],
       [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 1.10 THEN 1
 WHEN [Measures].[Muertes Nuevas] &lt;
      ([Measures].[Muertes Nuevas],
       [Dim Tiempo].[Anio].CurrentMember.PrevMember) * 0.90 THEN -1
 ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="696578fb-6a1b-4511-94b2-f23cc6da17a4">
      <ID>KPI 3</ID>
      <Name>KPI Variacion Mensual</Name>
      <Value>[Measures].[CrecimientoMensualCasos]</Value>
      <Goal>0</Goal>
      <Status>CASE
 WHEN IsEmpty(KPIValue("KPI Variacion Mensual")) THEN NULL
 WHEN KPIValue("KPI Variacion Mensual") &lt;= KPIGoal("KPI Variacion Mensual") THEN 1
 WHEN KPIValue("KPI Variacion Mensual") &lt;= 0.25 THEN 0
 ELSE -1
END</Status>
      <Trend>CASE
 WHEN IsEmpty([Measures].[CrecimientoMensualCasos]) THEN 0
 WHEN [Measures].[CrecimientoMensualCasos] &gt; 0.10 THEN 1
 WHEN [Measures].[CrecimientoMensualCasos] &lt; -0.10 THEN -1
 ELSE 0
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="9bb6805a-70b5-4fb3-8dac-01bc1a93a8cc">
      <ID>KPI 4</ID>
      <Name>KPI Vulnerabilidad</Name>
      <Value>[Measures].[IndiceVulnerabilidad]</Value>
      <Goal>([Measures].[IndiceVulnerabilidad],
 [Dim Pais].[Nombre Pais].DefaultMember,
 [Dim Pais].[Region].DefaultMember)</Goal>
      <Status>CASE
 WHEN IsEmpty(KPIValue("KPI Vulnerabilidad")) THEN NULL
 WHEN KPIValue("KPI Vulnerabilidad") &lt;= KPIGoal("KPI Vulnerabilidad") THEN 1
 WHEN KPIValue("KPI Vulnerabilidad") &lt;= KPIGoal("KPI Vulnerabilidad") * 1.25 THEN 0
 ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
