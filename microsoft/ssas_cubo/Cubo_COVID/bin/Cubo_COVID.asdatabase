                <xs:element name="dbo_FactCovidDiario" msprop:DbSchemaName="dbo" msprop:design-time-name="2c437f59-4eb8-4767-8673-522f2460adcd" msprop:FriendlyName="FactCovidDiario" msprop:TableType="Table" msprop:DbTableName="FactCovidDiario">
