      <Schema>
        <xs:schema id="COVID_x0020_DW" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
          <xs:element name="COVID_x0020_DW" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msprop:design-time-name="0a23ead6-eff2-4cde-adb3-9316df93157e">
            <xs:complexType>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="dbo_DimIndicadorAnual" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:design-time-name="667095f3-c4f9-49e1-a884-dd9b00e80c69" msprop:QueryDefinition="SELECT i.IndicadorAnualKey, i.NombrePais, i.Anio,&#xD;&#xA;       i.Poblacion, i.PibPerCapita, i.PrevalenciaDiabetes,&#xD;&#xA;       i.ExtremaPobreza, i.TasaMuerteCardiovasculares,&#xD;&#xA;       i.FacilidadesLavadoManos,&#xD;&#xA;       p.PaisKey, p.Region,&#xD;&#xA;       100.0 * (&#xD;&#xA;           (i.PrevalenciaDiabetes - (SELECT MIN(PrevalenciaDiabetes) FROM dbo.DimIndicadorAnual))&#xD;&#xA;             / NULLIF((SELECT MAX(PrevalenciaDiabetes) FROM dbo.DimIndicadorAnual)&#xD;&#xA;                    - (SELECT MIN(PrevalenciaDiabetes) FROM dbo.DimIndicadorAnual), 0)&#xD;&#xA;         + (i.ExtremaPobreza - (SELECT MIN(ExtremaPobreza) FROM dbo.DimIndicadorAnual))&#xD;&#xA;             / NULLIF((SELECT MAX(ExtremaPobreza) FROM dbo.DimIndicadorAnual)&#xD;&#xA;                    - (SELECT MIN(ExtremaPobreza) FROM dbo.DimIndicadorAnual), 0)&#xD;&#xA;         + (i.TasaMuerteCardiovasculares - (SELECT MIN(TasaMuerteCardiovasculares) FROM dbo.DimIndicadorAnual))&#xD;&#xA;             / NULLIF((SELECT MAX(TasaMuerteCardiovasculares) FROM dbo.DimIndicadorAnual)&#xD;&#xA;                    - (SELECT MIN(TasaMuerteCardiovasculares) FROM dbo.DimIndicadorAnual), 0)&#xD;&#xA;       ) / 3.0 AS IndiceVulnerabilidad&#xD;&#xA;FROM dbo.DimIndicadorAnual i&#xD;&#xA;JOIN dbo.DimPais p ON p.NombrePais = i.NombrePais" msprop:FriendlyName="DimIndicadorAnual" msprop:TableType="View" msprop:DbTableName="DimIndicadorAnual">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="IndicadorAnualKey" msdata:ReadOnly="true" msdata:AutoIncrement="true" msprop:FriendlyName="IndicadorAnualKey" msprop:DbColumnName="IndicadorAnualKey" msprop:design-time-name="b7efa10b-5433-4d22-bc51-5ad1ae0a5c64" type="xs:int" />
                      <xs:element name="NombrePais" msprop:FriendlyName="NombrePais" msprop:DbColumnName="NombrePais" msprop:design-time-name="a1b12ff2-6d1f-40bd-951f-15c4a3bc48fc" minOccurs="0">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:maxLength value="200" />
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="Anio" msprop:FriendlyName="Anio" msprop:DbColumnName="Anio" msprop:design-time-name="b71418ef-9a05-484c-836f-ff5a843d0021" type="xs:int" minOccurs="0" />
                      <xs:element name="Poblacion" msprop:FriendlyName="Poblacion" msprop:DbColumnName="Poblacion" msprop:design-time-name="dbdd27c2-ec06-4e50-8a29-d045b6f6cc4c" type="xs:long" minOccurs="0" />
                      <xs:element name="PibPerCapita" msprop:FriendlyName="PibPerCapita" msprop:DbColumnName="PibPerCapita" msprop:design-time-name="bcbd299b-e822-4e41-8110-31fbe045228f" type="xs:double" minOccurs="0" />
                      <xs:element name="PrevalenciaDiabetes" msprop:FriendlyName="PrevalenciaDiabetes" msprop:DbColumnName="PrevalenciaDiabetes" msprop:design-time-name="725d8efd-e313-44df-99eb-dc2883efc41b" type="xs:double" minOccurs="0" />
                      <xs:element name="ExtremaPobreza" msprop:FriendlyName="ExtremaPobreza" msprop:DbColumnName="ExtremaPobreza" msprop:design-time-name="b7dda314-f472-4e78-948f-0e8164c37cfc" type="xs:double" minOccurs="0" />
                      <xs:element name="TasaMuerteCardiovasculares" msprop:FriendlyName="TasaMuerteCardiovasculares" msprop:DbColumnName="TasaMuerteCardiovasculares" msprop:design-time-name="bab90c1d-d6b6-4734-ab8f-55b8507bee3d" type="xs:double" minOccurs="0" />
                      <xs:element name="FacilidadesLavadoManos" msprop:FriendlyName="FacilidadesLavadoManos" msprop:DbColumnName="FacilidadesLavadoManos" msprop:design-time-name="22b8060c-d3b8-4e5b-9ddf-3148edf6c6dc" type="xs:double" minOccurs="0" />
                      <xs:element name="PaisKey" msprop:DbColumnName="PaisKey" msprop:design-time-name="bd9f0ffd-b21f-47f2-8f3e-248b49ab33c3" type="xs:int" minOccurs="0" />
                      <xs:element name="Region" msprop:DbColumnName="Region" msprop:design-time-name="184afdd5-c89f-43d4-b3f6-e6c374ea22a4" minOccurs="0">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
